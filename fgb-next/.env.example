# AWS API Gateway endpoint that returns { Capitol, Paramount, Upcoming, Slideshow }
# (same endpoint the Vite app used as VITE_AWS_API_GATEWAY_URL)
NEXT_PUBLIC_AWS_API_GATEWAY_URL=

# Mapbox access token for the Locations page maps
# (same token the Vite app used as VITE_MAPBOX_API_KEY)
NEXT_PUBLIC_MAPBOX_API_KEY=
